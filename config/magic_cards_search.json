{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Magic Cards Search Config",
  "description": "Configuration for searching and scraping Magic: The Gathering singles and cards on Wallapop and Vinted",
  "game": "magic",
  "wallapop_settings": {
    "latitude": 40.4168,
    "longitude": -3.7038,
    "location_name": "Madrid, Spain",
    "order_by": "newest",
    "delay_between_requests_ms": 1500
  },
  "vinted_settings": {
    "domain": "vinted.es",
    "order_by": "newest_first",
    "delay_between_requests_ms": 2000,
    "enabled": true
  },
  "search_profiles": [
    {
      "id": "single_card",
      "name": "Magic: The Gathering Singles",
