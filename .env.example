# Database connection string for delta-cards
# SQLite example:
# DATABASE_URL=sqlite:///data/delta_cards.db
# PostgreSQL example:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/delta_cards

# ==============================================================================
# Discord Alert Configuration
# ==============================================================================
# Discord incoming webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Enable/disable Discord alerts (true / false)
DISCORD_ALERTS_ENABLED=true

# Alert Conditions:
# Minimum saving percentage threshold (e.g. 20.0 for 20% discount against market price)
ALERT_MIN_SAVING_PERCENTAGE=20.0

# Minimum absolute amount saved in EUR (e.g. 10.0 for 10€ discount)
ALERT_MIN_SAVING_ABSOLUTE=10.0

# Logical operator when both conditions are set ("or" / "and")
ALERT_CONDITION_OPERATOR=or
 
# Custom Discord emoji for wild offer alerts:
# Type \:pokeball_light: in your Discord server chat to get the exact ID! (e.g. <:pokeball_light:123456789012345678>)
ALERT_WILD_OFFER_EMOJI=":pokeball_light:"
# Debug mode:
# If true: send alerts with saved offers (useful for testing existing database deals)
# If false: do NOT send alerts for existing deals (only alert for newly scraped live offers)
DEBUG=false

# ==============================================================================
# Cardmarket Scraper & Anti-Bot Configuration
# ==============================================================================
# Optional proxy list (comma-separated):
# CARDMARKET_PROXIES=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080
# Or path to text file containing proxies (one per line):
# CARDMARKET_PROXIES_FILE=config/proxies.txt

# curl_cffi TLS impersonation profile (safari180, safari170, chrome124, chrome131)
CARDMARKET_IMPERSONATE=safari180

# Playwright browser simulation fallback if curl_cffi is challenged by Cloudflare
CARDMARKET_USE_PLAYWRIGHT_FALLBACK=true
CARDMARKET_PLAYWRIGHT_HEADLESS=true
CARDMARKET_PLAYWRIGHT_TIMEOUT=30.0
